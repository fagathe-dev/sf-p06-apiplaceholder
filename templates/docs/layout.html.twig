{% extends 'layouts/app.html.twig' %}

{% block title %}{% block doc_title %}{% endblock %} - Documentation de l'API{% endblock %}

{% block content %}
{% set route = app.request.attributes.get('_route') %}
{% set current = app.request.attributes.get('slug') %}
<div class="row g-6 py-4">
  <div class="col-12 col-lg-3">
    <nav aria-label="Documentation de l'API">
      <ul class="nav nav-pills nav-vertical">
        <li><a class="nav-link{{ route == 'app_docs_index' ? ' active' }}" href="{{ path('app_docs_index') }}"{{ route == 'app_docs_index' ? ' aria-current="page"' }}><i class="ri-book-2-line"></i> Vue d'ensemble</a></li>
        {% for item in resources %}
          <li><a class="nav-link{{ current == item.slug ? ' active' }}" href="{{ path('app_docs_resource', {slug: item.slug}) }}"{{ current == item.slug ? ' aria-current="page"' }}><i class="{{ item.icon }}"></i> {{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
  <div class="col-12 col-lg-9">
    {% block doc_content %}{% endblock %}
  </div>
</div>
{% endblock %}

{% block javascripts %}
  <script type="module" src="{{ asset('js/pages/try-it.js') }}"></script>
{% endblock %}
